{
    "name": "music-download-api",
    "image": "mcr.microsoft.com/devcontainers/go:1.27-bookworm",
    "initializeCommand": "docker network inspect ds454 >nul 2>&1 || docker network create ds454",
    "runArgs": [
        "--network=ds454"
    ],
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {}
    },
    "postStartCommand": "./.devcontainer/start.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go@0.58.0",
                "ms-azuretools.vscode-containers@2.5.2",
                "drblury.protobuf-vsc@1.6.15",
                "nicolasvuillamy.vscode-groovy-lint@4.2.1"
            ]
        }
    }
}
